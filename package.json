{
  "name": "gravity-browser",
  "productName": "Gravity",
  "version": "0.1.0",
  "description": "A quiet, keyboard-first browser for macOS, with a little physics.",
  "author": "Gravity contributors",
  "license": "MIT",
  "homepage": "https://github.com/OWNER/gravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/gravity.git"
  },
  "keywords": [
    "browser",
    "macos",
    "electron",
    "react",
    "motion"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:dir": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.77.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zustand": "^5.1.0"
  }
}
